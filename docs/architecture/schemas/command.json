{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r3akt.local/schema/command.json",
  "title": "R3AKTCommand",
  "type": "object",
  "required": [
    "command_id",
    "source",
    "timestamp",
    "command_type",
    "args"
  ],
  "properties": {
    "command_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "rns_identity"
      ],
      "properties": {
        "rns_identity": {
          "type": "string"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "command_type": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "object"
    },
    "correlation_id": {
      "type": "string"
    }
  }
}